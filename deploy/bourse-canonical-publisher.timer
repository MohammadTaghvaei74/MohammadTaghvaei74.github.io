[Unit]
Description=Refresh canonical fallback every five trading minutes and after close

[Timer]
OnCalendar=Sat,Sun,Mon,Tue,Wed *-*-* 08:45,50,55:00 Asia/Tehran
OnCalendar=Sat,Sun,Mon,Tue,Wed *-*-* 09..11:00/5:00 Asia/Tehran
OnCalendar=Sat,Sun,Mon,Tue,Wed *-*-* 12:00,05,10,15,20,25,30,35:00 Asia/Tehran
Persistent=true
AccuracySec=15s
Unit=bourse-canonical-publisher.service

[Install]
WantedBy=timers.target
