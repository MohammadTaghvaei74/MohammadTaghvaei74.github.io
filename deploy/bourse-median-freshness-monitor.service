[Unit]
Description=Alert on stale canonical median history
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=root
ExecStart=/usr/bin/python3 /root/bourse-canonical-publisher/deploy/median_freshness_monitor.py --repo /root/bourse-canonical-publisher --source /srv/sorena/market/data
NoNewPrivileges=true
ProtectSystem=full
ReadOnlyPaths=/srv/sorena/market/data /root/bourse-canonical-publisher
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
