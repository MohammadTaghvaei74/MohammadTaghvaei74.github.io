[Unit]
Description=Refresh verified Codal monthly investment-company reports
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=root
WorkingDirectory=/root/bourse-site
Environment=PYTHONUNBUFFERED=1
ExecStart=/usr/bin/flock -n /run/bourse-investment-reports.lock /root/bourse-alert/venv/bin/python /root/bourse-site/market/refresh_investment_reports.py
TimeoutStartSec=1800
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/root/bourse-site /run
UMask=0022
