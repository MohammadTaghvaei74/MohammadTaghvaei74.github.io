[Unit]
Description=Publish validated canonical fallback JSON with an isolated Git index
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=root
WorkingDirectory=/root/bourse-site
Environment=PYTHONUNBUFFERED=1
Environment=GIT_TERMINAL_PROMPT=0
Environment=CANONICAL_SKIP_FETCH=1
ExecStart=/usr/bin/flock -n /run/bourse-canonical-publisher.lock /usr/bin/python3 /root/bourse-site/deploy/canonical_data_publisher.py --repo /root/bourse-site --source /srv/sorena/market/data
TimeoutStartSec=300
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadOnlyPaths=/srv/sorena/market/data /root/bourse-site
ReadWritePaths=/root/bourse-site/.git
UMask=0022
